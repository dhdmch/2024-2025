<http://example.org/evento/ritorno_pio_IV> a schema:Event ;
    schema:name "Restauro sotto Pio IV" ;
    schema:startDate "1559"^^xsd:gYear ;
    schema:location <https://www.wikidata.org/entity/Q220> ;
    schema:description "Restauro della chiesa di S. Angelo in Borgo sotto il pontificato di Pio IV." .

<http://example.org/evento/ristauro_bonifacio_ii> a schema:Event ;
    schema:name "Fondazione di S. Angelo in Peschieria" ;
