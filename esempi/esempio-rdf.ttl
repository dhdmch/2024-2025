@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix schema: <http://schema.org/> .


<http://example.org/chiesa/sandrea-invinchi> a schema:Place ;
    rdfs:label "S. Andrea in Vinchi" ;
    schema:location <https://www.wikidata.org/entity/Q220> ;
    dcterms:description "Chiesa di origine antica, riedificata nel XVI secolo da Carlo de Mochis." ;
    dcterms:created "XVI secolo"^^rdf:Literal .

<http://example.org/chiesa/sangelo_inborgo> a schema:Place ;
    rdfs:label "S. Angelo in Borgo" ;
    schema:location <https://www.wikidata.org/entity/Q220> ;
    dcterms:description "Chiesa riedificata sotto Pio IV nel 1559." ;
    dcterms:created "1559"^^xsd:gYear .

<http://example.org/chiesa/sangelocustode> a schema:Place ;
    rdfs:label "S. Angelo Custode" ;
    schema:location <https://www.wikidata.org/entity/Q220> ;
    dcterms:description "Chiesa edificata da Felice della Greca, con facciata di Mattia de Rossi." ;
    dcterms:created "XVII secolo"^^rdf:Literal .

<http://example.org/chiesa/sangeloinpeschiera> a schema:Place ;
    rdfs:label "S. Angelo in Peschieria" ;
    schema:location <https://www.wikidata.org/entity/Q220> ;
    dcterms:description "Chiesa edificata nel 480 da Bonifacio II." ;
    dcterms:created "480"^^xsd:gYear .

